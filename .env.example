# Copy to .env and edit. NEVER commit .env (it holds API secrets).
# The bot re-reads this file every 60 s (live/kill-switch/risk/execution settings apply without a
# restart; strategy parameters, capital and API keys need a restart).

# ---- global ----
BINANCE_TESTNET=false
LIVE_CONFIRM=                      # must equal I_UNDERSTAND_REAL_MONEY for any live trading
KILL_SWITCH=false
DATA_DIR=./data
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
LOG_LEVEL=INFO

# ---- strategy parameters (shared defaults) ----
OVERLAY_EMA_SPAN_MIN=4320
OVERLAY_ENTRY=0.06
OVERLAY_EXIT=0.002
OVERLAY_TICKET=0.25
OVERLAY_MAX_HOLD_MIN=4320
LADDER_ENABLED=true
LADDER_EMA_SPAN_DAYS=60
LADDER_TIERS=0.15:0.15,0.30:0.30
LADDER_EXIT=0.05
W_MIN=0.05
W_MAX=0.95
# Warm-up (spec minimums): overlay 0 = 3 x OVERLAY_EMA_SPAN_MIN bars; ladder 180 daily closes
OVERLAY_WARMUP_BARS=0
LADDER_WARMUP_DAYS=180

# ---- execution ----
MAX_SLIPPAGE=0.003
MAX_SLICE_USD=500
SLICE_INTERVAL_SEC=30
ORDER_TIMEOUT_SEC=300
MIN_TRADE_USD=10
MAX_RETRIES=10
USE_BNB_FEES=true
BNB_MIN_USD=5
FEE_RATE=0.001                     # used for paper simulation (0.00075 with BNB discount)
# OPTIONAL, not part of the strategy spec: extra simulated impact for paper fills (bps per 1,000 USD)
PAPER_IMPACT_BPS_PER_1K=0

# ---- risk limits ----
MAX_ORDER_USD=1500
MAX_TRADES_PER_DAY=30
MAX_DAILY_TURNOVER_PCT=300

# ---- instance s1k ----
S1K_ENABLED=true
S1K_CAPITAL_USD=1000
S1K_LIVE=false
S1K_API_KEY=
S1K_API_SECRET=
# optional per-instance overrides, e.g. S1K_OVERLAY_ENTRY=0.05

# ---- instance s4k ----
S4K_ENABLED=true
S4K_CAPITAL_USD=4000
S4K_LIVE=false
S4K_API_KEY=
S4K_API_SECRET=

# ---- development only: local fake exchange (python -m tools.fake_binance) ----
# BINANCE_REST_URL=http://127.0.0.1:8090
# BINANCE_WS_URL=ws://127.0.0.1:8090
